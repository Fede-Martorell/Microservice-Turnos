# Copiar a .env.local en una instalación nueva. No sobrescribir configuración existente.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Solo hosting del piloto: el contenedor/arranque estricto lo activa automáticamente.
PILOT_DEPLOYMENT=0
# Fase 1: URL y clave publicable del proyecto autorizado, dentro de .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Fase 5: solo servidor. Nunca usar prefijo NEXT_PUBLIC_ para secretos.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
# Fase 5: secreto de autenticación para ejecución de trabajos programados.
CRON_SECRET=
NOTIFICATION_WORKER_SECRET=
# disabled (predeterminado), test (solo destinatario permitido) o live (dominio HTTPS verificado).
NOTIFICATION_MODE=disabled
NOTIFICATION_TEST_RECIPIENT=
# Fase 4: clave de servidor hexadecimal de 64 caracteres, generada por npm run prepare:public-booking.
PUBLIC_BOOKING_GATEWAY_SECRET=
# Fuera de localhost se requiere Turnstile para crear reservas públicas.
PUBLIC_BOOKING_TURNSTILE_SITE_KEY=
PUBLIC_BOOKING_TURNSTILE_SECRET_KEY=
