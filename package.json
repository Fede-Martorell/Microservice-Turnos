{
  "name": "reservas-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:concurrency": "node scripts/test-concurrency.mjs",
    "prepare:public-booking": "node scripts/prepare-public-booking.mjs",
    "prepare:notifications": "node scripts/prepare-notifications.mjs",
    "prepare:platform-admin": "node scripts/prepare-platform-admin.mjs",
    "notifications:run": "node scripts/run-notifications.mjs",
    "pilot:check": "node scripts/check-pilot.mjs",
    "pilot:measure": "node scripts/measure-pilot.mjs",
    "pilot:artifacts": "node scripts/check-artifacts.mjs",
    "pilot:smoke": "node scripts/test-pilot-runtime.mjs",
    "repo:check": "node scripts/check-repository.mjs",
    "showcase:capture": "node scripts/capture-showcase.mjs",
    "start:pilot": "node scripts/start-pilot.mjs",
    "test:e2e": "playwright test",
    "test:e2e:public": "node scripts/run-public-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run repo:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run pilot:artifacts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
